PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://docai:docai@localhost:5432/document_ai
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000
# Shared secret so only this server can call the ai-service internal API.
# Must match INTERNAL_API_KEY in ai-service/.env
INTERNAL_API_KEY=replace-with-a-long-random-string

# local | s3
STORAGE_DRIVER=local
STORAGE_DIR=../storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=25
