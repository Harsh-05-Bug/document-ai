PORT=4000

# Allowed browser origins, comma-separated. Compared as exact strings, so
# no trailing slash: https://app.example.com, not https://app.example.com/
CLIENT_ORIGIN=http://localhost:5173

# Postgres with the pgvector extension (Neon, Supabase, local, ...)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/document_ai

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000
# Shared secret so only this server can call the ai-service internal API.
# Must match INTERNAL_API_KEY in ai-service/.env
INTERNAL_API_KEY=replace-with-a-long-random-string

# Set to true when deployed behind a proxy (Render, Fly, nginx) so rate
# limiting sees the real client IP. Leave false locally: trusting the
# header without a proxy lets anyone spoof their IP.
TRUST_PROXY=false

# local | s3
STORAGE_DRIVER=local
STORAGE_DIR=../storage

# Used when STORAGE_DRIVER=s3. Works with any S3-compatible service.
# S3_ENDPOINT is only needed for providers other than AWS, e.g.
#   Supabase: https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_S3_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=25