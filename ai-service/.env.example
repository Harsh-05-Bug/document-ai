DATABASE_URL=postgresql://postgres:your-password@localhost:5432/document_ai

# Must match INTERNAL_API_KEY in server/.env
INTERNAL_API_KEY=replace-with-a-long-random-string

# Any OpenAI-compatible provider. Defaults below are Google Gemini.
# Get a free key at https://aistudio.google.com
# Remove OPENAI_BASE_URL to use OpenAI directly.
OPENAI_API_KEY=your-gemini-api-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

EMBEDDING_MODEL=gemini-embedding-001
# Must match VECTOR(n) in infra/migrations/001_init.sql.
# pgvector's HNSW index supports at most 2000 dimensions.
EMBEDDING_DIM=1536
LLM_MODEL=gemini-3.1-flash-lite

# Retrieval knobs
TOP_K=5
# Cosine similarity floor. Below this we refuse to answer instead of
# letting the model improvise. Tune it against your own documents.
SIMILARITY_THRESHOLD=0.35
CHUNK_TOKENS=600
CHUNK_OVERLAP=80

# local | s3   (must match the Node server's setting and point at the
# same place it writes to)
STORAGE_DRIVER=local
STORAGE_DIR=../storage

# Used when STORAGE_DRIVER=s3. Same values as server/.env.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=