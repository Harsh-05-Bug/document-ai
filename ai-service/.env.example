DATABASE_URL=postgresql://docai:docai@localhost:5432/document_ai

# Must match INTERNAL_API_KEY in server/.env
INTERNAL_API_KEY=replace-with-a-long-random-string

OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini

# Retrieval knobs
TOP_K=5
# Cosine similarity floor. Below this we refuse to answer instead of
# letting the model improvise. Tune it against your own documents.
SIMILARITY_THRESHOLD=0.35
CHUNK_TOKENS=600
CHUNK_OVERLAP=80

# local | s3   (local must point at the same volume the Node server writes to)
STORAGE_DRIVER=local
STORAGE_DIR=../storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
